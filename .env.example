# מפתח API של Anthropic (או התחברות עם `ant auth login`)
ANTHROPIC_API_KEY=sk-ant-...

# המודל של חברי הכנסת: מחקר, נאומים, הצבעה וגם היו"ר
MK_MODEL=claude-opus-5-5
# מודל זול להקשבה: תגובות, מחשבות וקריאות ביניים אחרי כל נאום
REACTION_MODEL=claude-haiku-5-5
# low | medium | high | xhigh | max
SPEECH_EFFORT=medium
RESEARCH_EFFORT=medium
# כמה קריאות API של ח"כים רצות במקביל
CONCURRENCY=4
# off מכבה את שלב ההקשבה (חוסך עלות, אבל אין מחשבות וקריאות ביניים)
REACTIONS=on
# 1 מפעיל מצב דמו בלי API (תוכן מוכן מראש, לבדיקת ה-UI)
MOCK=0
PORT=3000
